{
    "name": "qzone-export",
    "version": "3.0",
    "description": "QQ空间导出助手，用于导出备份QQ空间的说说、日志、日记、相册、视频、留言、好友、收藏、分享、访客为文件，便于迁移与保存",
    "private": true,
    "type": "module",
    "license": "Apache-2.0",
    "homepage": "https://github.com/ShunCai/QZoneExport",
    "scripts": {
        "postinstall": "wxt prepare",
        "dev": "wxt",
        "build": "npm run build:viewer && wxt build",
        "zip": "npm run build:viewer && wxt zip",
        "dev:viewer": "node scripts/gen-viewer-mock.mjs && vite --config viewer/vite.config.ts",
        "build:viewer": "vite build --config viewer/vite.config.ts",
        "compile": "tsc --noEmit",
        "compile:viewer": "vue-tsc --noEmit -p viewer/tsconfig.json",
        "test": "vitest run",
        "lint": "eslint .",
        "format": "prettier --write ."
    },
    "devDependencies": {
        "@eslint/js": "^9.39.2",
        "@types/chrome": "^0.1.32",
        "@types/node": "^26.1.2",
        "@vitejs/plugin-vue": "^6.0.8",
        "@wxt-dev/module-vue": "^1.0.3",
        "eslint": "^9.39.2",
        "eslint-plugin-vue": "^10.10.0",
        "fake-indexeddb": "^6.2.5",
        "globals": "^17.8.0",
        "happy-dom": "^20.11.1",
        "prettier": "^3.8.1",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.65.0",
        "vite": "^7.3.6",
        "vitest": "^3.2.4",
        "vue-eslint-parser": "^10.4.1",
        "vue-tsc": "^3.3.9",
        "wxt": "^0.21.2"
    },
    "dependencies": {
        "@zip.js/zip.js": "^2.8.34",
        "echarts": "^6.1.0",
        "idb": "^8.0.3",
        "json5": "^2.2.3",
        "naive-ui": "^2.44.1",
        "photoswipe": "^5.4.4",
        "pinia": "^4.0.2",
        "vue": "^3.5.40",
        "xlsx": "^0.18.5"
    }
}
